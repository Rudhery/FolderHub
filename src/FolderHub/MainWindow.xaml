<Window x:Class="FolderHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FolderHub"
        Width="562"
        SizeToContent="Height"
        AllowDrop="True"
        AllowsTransparency="False"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            NonClientFrameEdges="None"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ControlTemplate x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        Margin="{TemplateBinding Padding}"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                <ScrollBar x:Name="PART_VerticalScrollBar"
                           HorizontalAlignment="Right"
                           Style="{StaticResource ThinScrollBar}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           Orientation="Vertical"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
        </ControlTemplate>

        <Style x:Key="CardsListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Padding="{TemplateBinding Padding}"
                                      CanContentScroll="False"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Template="{StaticResource OverlayScrollViewer}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ MENU DE CONTEXTO ============  -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextLabel}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="B" Padding="10,0" Background="Transparent" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="19" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="&#xE73E;"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Header" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource CardBgHover}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="9,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{StaticResource Divider}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="5"
                                Background="#F51A1C20"
                                BorderBrush="{StaticResource SurfaceBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" Opacity="0.7" ShadowDepth="6" Color="Black" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ============ ABA ============  -->
        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="MouseRightButtonUp" Handler="TabItem_MouseRightButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill"
                                Height="30"
                                Padding="13,0"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock x:Name="Label"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextLabel}"
                                       Text="{Binding Name}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource CardBgHover}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource CardBorderHover}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource CardBgSelected}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource CardBorderSelected}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextStrong}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TabMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Style="{StaticResource DarkMenuItem}" Click="RevealTab_Click" Header="Abrir esta pasta" />
            <MenuItem Style="{StaticResource DarkMenuItem}"
                      Click="RemoveTab_Click"
                      Header="Remover esta aba"
                      Tag="remove" />
        </ContextMenu>

        <!--  bandeja: clique direito no ícone  -->
        <ContextMenu x:Key="TrayMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Style="{StaticResource DarkMenuItem}" Click="TrayOpen_Click" Header="Abrir o hub" />
            <MenuItem Style="{StaticResource DarkMenuItem}" Click="ChangeFolder_Click" Header="Trocar pasta…" />
            <MenuItem Style="{StaticResource DarkMenuItem}"
                      Click="ToggleStartup_Click"
                      Header="Iniciar com o Windows"
                      Tag="startup" />
            <Separator Style="{StaticResource DarkSeparator}" />
            <MenuItem Style="{StaticResource DarkMenuItem}" Click="TrayExit_Click" Header="Sair" />
        </ContextMenu>

        <!--  clique direito no cabeçalho  -->
        <ContextMenu x:Key="OptionsMenu" Style="{StaticResource DarkContextMenu}">
            <MenuItem Style="{StaticResource DarkMenuItem}"
                      Click="ToggleResident_Click"
                      Header="Modo residente"
                      Tag="resident" />
            <MenuItem Style="{StaticResource DarkMenuItem}"
                      Click="ToggleStartup_Click"
                      Header="Iniciar com o Windows"
                      Tag="startup" />
            <Separator Style="{StaticResource DarkSeparator}" />
            <MenuItem Style="{StaticResource DarkMenuItem}" Click="AddTab_Click" Header="Adicionar uma aba…" />
            <MenuItem Style="{StaticResource DarkMenuItem}" Click="OpenFolder_Click" Header="Abrir a pasta do hub" />
            <MenuItem Style="{StaticResource DarkMenuItem}" Click="OpenConfig_Click" Header="Abrir a configuração" />
        </ContextMenu>

        <!--
            ============ CARD ============
            Cada estado é uma camada com a cor exata do design, e elas se cruzam
            por opacidade em 150ms. Sobrepor uma cor translúcida na outra somaria
            os alfas e daria um tom mais claro do que o especificado.
        -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="{StaticResource CardWidth}" />
            <Setter Property="Height" Value="{StaticResource CardHeight}" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <EventSetter Event="Loaded" Handler="Card_Loaded" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="ToNormal">
                                <DoubleAnimation Storyboard.TargetName="StateNormal" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="StateHover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="StateSelected" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileNormal" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileHover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileSelected" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="SelectRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                            </Storyboard>

                            <Storyboard x:Key="ToHover">
                                <DoubleAnimation Storyboard.TargetName="StateNormal" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="StateHover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="StateSelected" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileNormal" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileHover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileSelected" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="SelectRing" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                            </Storyboard>

                            <Storyboard x:Key="ToSelected">
                                <DoubleAnimation Storyboard.TargetName="StateNormal" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="StateHover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="StateSelected" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileNormal" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileHover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="TileSelected" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateDuration}" />
                                <DoubleAnimation Storyboard.TargetName="SelectRing" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource StateDuration}" />
                            </Storyboard>
                        </ControlTemplate.Resources>

                        <Grid>
                            <!--  box-shadow: 0 0 0 2px rgba(255,255,255,0.05)  -->
                            <Border x:Name="SelectRing"
                                    Margin="-2"
                                    BorderBrush="{StaticResource CardRing}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Opacity="0" />

                            <Border x:Name="StateNormal"
                                    Background="{StaticResource CardBg}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Opacity="1" />
                            <Border x:Name="StateHover"
                                    Background="{StaticResource CardBgHover}"
                                    BorderBrush="{StaticResource CardBorderHover}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Opacity="0" />
                            <Border x:Name="StateSelected"
                                    Background="{StaticResource CardBgSelected}"
                                    BorderBrush="{StaticResource CardBorderSelected}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Opacity="0" />

                            <!--  padding: 24px 12px 18px  ·  gap: 14px  -->
                            <StackPanel Margin="12,24,12,18" VerticalAlignment="Top">
                                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                    <Border x:Name="TileNormal"
                                            Background="{StaticResource TileBg}"
                                            BorderBrush="{StaticResource TileBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Opacity="1" />
                                    <Border x:Name="TileHover"
                                            Background="{StaticResource TileBgHover}"
                                            BorderBrush="{StaticResource TileBorderHover}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Opacity="0" />
                                    <Border x:Name="TileSelected"
                                            Background="{StaticResource TileBgSelected}"
                                            BorderBrush="{StaticResource TileBorderSelected}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Opacity="0" />

                                    <TextBlock x:Name="Initial"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Glyph}"
                                               Text="{Binding Initial}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVisInverted}}" />

                                    <Image Width="28"
                                           Height="28"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                </Grid>

                                <TextBlock x:Name="Label"
                                           Height="32"
                                           Margin="0,14,0,0"
                                           FontSize="12.5"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TextLabel}"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter TargetName="Initial" Property="Foreground" Value="#B3C5D6" />
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ToHover}" />
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource ToNormal}" />
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextStrong}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Initial" Property="Foreground" Value="#DBE4EC" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource ToSelected}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource ToNormal}" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  ================= MODAL =================  -->
    <Border x:Name="Shell"
            Padding="30,30,30,24"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource SurfaceBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShellLift" Y="8" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ CABEÇALHO ============  -->
            <Grid x:Name="Header"
                  Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  MouseRightButtonUp="Header_MouseRightButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               MaxWidth="170"
                               HorizontalAlignment="Left"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Folder Hub"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText"
                               MaxWidth="180"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Left"
                               FontSize="12.5"
                               Foreground="{StaticResource TextFaint}"
                               Text="Escolha um aplicativo"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border Grid.Column="2"
                        Width="176"
                        Height="30"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource ControlBg}"
                        BorderBrush="{StaticResource ControlBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid Margin="9,0,9,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,7,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="&#xE721;" />
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="SearchPlaceholder"
                                       VerticalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextFaint}"
                                       IsHitTestVisible="False"
                                       Text="Buscar" />
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0"
                            Style="{StaticResource GlyphButton}"
                            Click="Sort_Click"
                            Content="&#xE8CB;"
                            ToolTip="Ordenar">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenu}">
                                <MenuItem Style="{StaticResource DarkMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Manual &#x2014; arraste os cards"
                                          Tag="Manual" />
                                <MenuItem Style="{StaticResource DarkMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Nome (A &#x2192; Z)"
                                          Tag="NameAsc" />
                                <MenuItem Style="{StaticResource DarkMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Nome (Z &#x2192; A)"
                                          Tag="NameDesc" />
                                <MenuItem Style="{StaticResource DarkMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Mais recentes"
                                          Tag="Recent" />
                                <Separator Style="{StaticResource DarkSeparator}" />
                                <MenuItem Style="{StaticResource DarkMenuItem}"
                                          Click="FreezeOrder_Click"
                                          Header="Gravar esta ordem na pasta" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource GlyphButton}"
                            Click="ChangeFolder_Click"
                            Content="&#xE8B7;"
                            ToolTip="Trocar pasta (Ctrl+O)" />
                    <Button Style="{StaticResource GlyphButton}"
                            Click="Reload_Click"
                            Content="&#xE72C;"
                            ToolTip="Recarregar (F5)" />
                    <Button Style="{StaticResource GlyphButton}"
                            Click="Close_Click"
                            Content="&#xE8BB;"
                            ToolTip="Fechar (Esc)" />
                </StackPanel>
            </Grid>

            <!--
                ============ ABAS ============
                Fica escondida com uma pasta só, então o layout de sempre não muda.
            -->
            <ListBox x:Name="TabStrip"
                     Grid.Row="1"
                     Margin="0,18,0,0"
                     HorizontalAlignment="Left"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     ItemContainerStyle="{StaticResource TabItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="TabStrip_SelectionChanged"
                     Visibility="Collapsed">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!--  ============ GRID DE CARDS ============  -->
            <ListBox x:Name="Cards"
                     Grid.Row="2"
                     Margin="-5,21,-5,-5"
                     AllowDrop="True"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Style="{StaticResource CardsListBox}"
                     ItemContainerStyle="{StaticResource CardItem}"
                     SelectionMode="Single"
                     VirtualizingPanel.IsVirtualizing="False">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem Style="{StaticResource DarkMenuItem}"
                                  Click="RunAsAdmin_Click"
                                  Header="Executar como administrador" />
                        <MenuItem Style="{StaticResource DarkMenuItem}"
                                  Click="Reveal_Click"
                                  Header="Mostrar na pasta" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!--  ============ ESTADO VAZIO ============  -->
            <StackPanel x:Name="EmptyState"
                        Grid.Row="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Background="{StaticResource TileBg}"
                        BorderBrush="{StaticResource TileBorder}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{StaticResource Glyph}"
                               Text="&#xE8B7;" />
                </Border>
                <TextBlock x:Name="EmptyTitle"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="Nenhum atalho aqui" />
                <TextBlock x:Name="EmptyHint"
                           MaxWidth="330"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{StaticResource TextFaint}"
                           Text="Solte atalhos (.lnk, .url, .exe) dentro da pasta e eles aparecem aqui na hora."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource QuietButton}"
                        Click="OpenFolder_Click"
                        Content="Abrir a pasta" />
            </StackPanel>

            <!--  ============ RODAPÉ ============  -->
            <Grid Grid.Row="3" Margin="0,22,0,0">
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Divider}" />
                <Grid Margin="0,16,0,0">
                    <TextBlock x:Name="CountText"
                               HorizontalAlignment="Left"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMeta}"
                               Text="0 atalhos" />
                    <TextBlock HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource TextMeta}"
                               Text="&#x21B5; abrir &#xB7; esc fechar" />
                </Grid>
            </Grid>

            <!--  arrastar e soltar  -->
            <Border x:Name="DropOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Margin="-30,-30,-30,-24"
                    Background="#E61A1C20"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{StaticResource TileBgSelected}"
                            BorderBrush="{StaticResource TileBorderSelected}"
                            BorderThickness="1"
                            CornerRadius="14" />
                    <TextBlock x:Name="DropText"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Solte para usar esta pasta" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
