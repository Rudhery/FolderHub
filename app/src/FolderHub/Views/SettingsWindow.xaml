<views:HubWindow x:Class="FolderHub.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hub="clr-namespace:FolderHub.Controls"
        xmlns:views="clr-namespace:FolderHub.Views"
        Title="Configuração — FolderHub"
        Width="760"
        Height="566"
        ShowInTaskbar="False">

    <Window.Resources>
        <!--  a navegação lateral é o HubCard discreto, com o conteúdo deitado  -->
        <Style x:Key="NavItem" TargetType="{x:Type hub:HubCard}" BasedOn="{StaticResource {x:Type hub:HubCard}}">
            <Setter Property="Variant" Value="Quiet" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource SurfaceBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}"
            Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShellLift" Y="8" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ CABEÇALHO ============  -->
            <Grid x:Name="Header"
                  Grid.Row="0"
                  Margin="24,22,24,0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="{StaticResource SizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Configuração" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="{StaticResource SizeBody}"
                               Foreground="{StaticResource TextFaint}"
                               Text="Tudo vale na hora — não precisa reiniciar o hub." />
                </StackPanel>

                <hub:HubIconButton Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Click="Close_Click"
                                   Glyph="Close"
                                   ToolTip="Fechar (Esc)" />
            </Grid>

            <!--  ============ CORPO ============  -->
            <Grid Grid.Row="1" Margin="24,18,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <hub:HubCardList x:Name="Sections"
                                 Grid.Column="0"
                                 VerticalAlignment="Top"
                                 Style="{StaticResource BareListBox}"
                                 ItemContainerStyle="{StaticResource NavItem}"
                                 SelectionChanged="Sections_SelectionChanged">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center"
                                        hub:HubSpacing.Gap="Medium"
                                        Orientation="Horizontal">
                                <hub:HubIcon FontSize="{StaticResource SizeGlyph}" Glyph="{Binding Glyph}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{StaticResource SizeBody}"
                                           FontWeight="Medium"
                                           Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </hub:HubCardList>

                <Border Grid.Column="1"
                        Margin="20,0,0,0"
                        Padding="20,0,0,0"
                        BorderBrush="{StaticResource Divider}"
                        BorderThickness="1,0,0,0">
                    <ScrollViewer Padding="0,0,0,8"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Template="{StaticResource OverlayScrollViewer}"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>

                            <!--  ============ HUBS ============  -->
                            <StackPanel x:Name="PageHubs">
                                <TextBlock Foreground="{StaticResource TextFaint}"
                                           FontSize="{StaticResource SizeHint}"
                                           Text="Cada hub é uma pasta. O que estiver dentro dela vira card — não há lista de programas em lugar nenhum."
                                           TextWrapping="Wrap" />

                                <ItemsControl x:Name="HubList" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="12,10"
                                                    Background="{StaticResource CardBg}"
                                                    BorderBrush="{StaticResource CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusQuiet}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBox MaxLength="40"
                                                                 Style="{StaticResource HubTextBox}"
                                                                 KeyDown="HubName_KeyDown"
                                                                 LostFocus="HubName_LostFocus"
                                                                 Tag="{Binding}"
                                                                 Text="{Binding Name, Mode=OneTime}" />
                                                        <TextBlock Margin="2,6,0,0"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="{StaticResource SizeKey}"
                                                                   Foreground="{StaticResource TextFaint}"
                                                                   Text="{Binding Path}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Path}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Top"
                                                                hub:HubSpacing.Gap="XSmall"
                                                                Orientation="Horizontal">
                                                        <hub:HubIconButton Click="HubUp_Click"
                                                                           Glyph="ChevronRight"
                                                                           Tag="{Binding}"
                                                                           ToolTip="Subir">
                                                            <hub:HubIconButton.RenderTransform>
                                                                <RotateTransform Angle="-90" CenterX="14" CenterY="14" />
                                                            </hub:HubIconButton.RenderTransform>
                                                        </hub:HubIconButton>
                                                        <hub:HubIconButton Click="HubDown_Click"
                                                                           Glyph="ChevronRight"
                                                                           Tag="{Binding}"
                                                                           ToolTip="Descer">
                                                            <hub:HubIconButton.RenderTransform>
                                                                <RotateTransform Angle="90" CenterX="14" CenterY="14" />
                                                            </hub:HubIconButton.RenderTransform>
                                                        </hub:HubIconButton>
                                                        <hub:HubIconButton Click="HubReveal_Click"
                                                                           Glyph="Folder"
                                                                           Tag="{Binding}"
                                                                           ToolTip="Abrir no Explorer" />
                                                        <hub:HubIconButton Click="HubRemove_Click"
                                                                           Glyph="Delete"
                                                                           Tag="{Binding}"
                                                                           ToolTip="Remover este hub" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel hub:HubSpacing.Gap="Medium" Orientation="Horizontal">
                                    <Button x:Name="AddHub"
                                            Style="{StaticResource QuietButton}"
                                            Click="AddHub_Click"
                                            Content="Adicionar hub" />
                                    <TextBlock x:Name="HubCountHint"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource SizeHint}"
                                               Foreground="{StaticResource TextFaint}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  ============ GERAL ============  -->
                            <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                                <hub:HubOption Title="Iniciar com o Windows"
                                               Description="Entra escondido na bandeja quando você liga a máquina, pronto para o atalho.">
                                    <hub:HubToggle x:Name="StartupToggle" Click="Startup_Click" />
                                </hub:HubOption>

                                <Border Height="1" Background="{StaticResource Divider}" />

                                <hub:HubOption Title="Ficar residente na bandeja"
                                               Description="Sem isso o atalho global não funciona: não há processo esperando por ele.">
                                    <hub:HubToggle x:Name="ResidentToggle" Click="Resident_Click" />
                                </hub:HubOption>

                                <Border Height="1" Background="{StaticResource Divider}" />

                                <hub:HubOption Title="Fechar depois de abrir um app"
                                               Description="É o que faz o hub se comportar como lançador, e não como janela.">
                                    <hub:HubToggle x:Name="CloseAfterToggle" Click="CloseAfter_Click" />
                                </hub:HubOption>

                                <Border Height="1" Background="{StaticResource Divider}" />

                                <hub:HubOption Title="Fechar ao perder o foco"
                                               Description="Clicar fora some com o hub.">
                                    <hub:HubToggle x:Name="CloseOnBlurToggle" Click="CloseOnBlur_Click" />
                                </hub:HubOption>
                            </StackPanel>

                            <!--  ============ ATALHOS ============  -->
                            <StackPanel x:Name="PageKeys" Visibility="Collapsed">
                                <hub:HubOption Title="Atalho global"
                                               Description="Clique e pressione a combinação. Backspace limpa; Esc desiste.">
                                    <hub:HubHotKeyBox x:Name="HotKeyBox" HotKeyChanged="HotKey_Changed" />
                                </hub:HubOption>

                                <TextBlock x:Name="HotKeyWarning"
                                           Margin="0,2,0,0"
                                           FontSize="{StaticResource SizeHint}"
                                           Foreground="{StaticResource TextMeta}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <Border Height="1" Margin="0,10,0,0" Background="{StaticResource Divider}" />

                                <TextBlock Margin="0,16,0,10"
                                           FontSize="{StaticResource SizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLabel}"
                                           Text="Dentro do hub" />

                                <ItemsControl x:Name="KeyReference">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="118" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hub:HubKey Grid.Column="0"
                                                            HorizontalAlignment="Left"
                                                            Text="{Binding Keys}" />
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource SizeHint}"
                                                           Foreground="{StaticResource TextMeta}"
                                                           Text="{Binding What}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  ============ APARÊNCIA ============  -->
                            <StackPanel x:Name="PageLook" Visibility="Collapsed">
                                <hub:HubOption Title="Ordenação dos cards"
                                               Description="Manual segue os prefixos dos arquivos na pasta, então a ordem é a mesma no Explorer.">
                                    <ComboBox x:Name="SortSelect"
                                              Style="{StaticResource HubSelect}"
                                              SelectionChanged="Sort_Changed" />
                                </hub:HubOption>

                                <Border Height="1" Background="{StaticResource Divider}" />

                                <hub:HubOption Title="Máximo de colunas"
                                               Description="O hub escolhe quantas colunas usar até este limite, preferindo deixar a última fileira cheia.">
                                    <hub:HubStepper x:Name="ColumnsStepper"
                                                    Maximum="10"
                                                    Minimum="3"
                                                    Unit="colunas"
                                                    ValueChanged="Columns_Changed" />
                                </hub:HubOption>

                                <Border Height="1" Background="{StaticResource Divider}" />

                                <hub:HubOption Title="Arquivo de tema"
                                               Description="Um .xaml carregado depois do tema embutido: o que ele definir vence.">
                                    <StackPanel hub:HubSpacing.Gap="Small" Orientation="Horizontal">
                                        <Button Padding="12,0"
                                                Style="{StaticResource QuietButton}"
                                                Click="PickTheme_Click"
                                                Content="Escolher…" />
                                        <Button x:Name="ClearTheme"
                                                Padding="12,0"
                                                Style="{StaticResource QuietButton}"
                                                Click="ClearTheme_Click"
                                                Content="Limpar" />
                                    </StackPanel>
                                </hub:HubOption>

                                <TextBlock x:Name="ThemePath"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource SizeKey}"
                                           Foreground="{StaticResource TextFaint}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!--  ============ SOBRE ============  -->
                            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                <TextBlock FontSize="{StaticResource SizeTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="FolderHub" />
                                <TextBlock x:Name="VersionText"
                                           Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource SizeMeta}"
                                           Foreground="{StaticResource TextMeta}" />
                                <TextBlock Margin="0,14,0,0"
                                           MaxWidth="420"
                                           HorizontalAlignment="Left"
                                           FontSize="{StaticResource SizeBody}"
                                           Foreground="{StaticResource TextFaint}"
                                           Text="Um lançador que transforma uma pasta de atalhos num hub visual. A pasta é a configuração: não existe registro de aplicativos nem banco de dados."
                                           TextWrapping="Wrap" />

                                <Border Height="1" Margin="0,18,0,18" Background="{StaticResource Divider}" />

                                <hub:HubOption Title="Arquivo de configuração"
                                               Description="Dá para editar à mão; o hub relê sozinho quando ele muda.">
                                    <Button Style="{StaticResource QuietButton}"
                                            Click="OpenConfigFolder_Click"
                                            Content="Abrir a pasta" />
                                </hub:HubOption>

                                <TextBlock x:Name="ConfigPath"
                                           Margin="0,2,0,0"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource SizeKey}"
                                           Foreground="{StaticResource TextFaint}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!--  ============ RODAPÉ ============  -->
            <Grid Grid.Row="2" Margin="24,16,24,18">
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Divider}" />
                <Grid Margin="0,14,0,0">
                    <TextBlock x:Name="StatusText"
                               HorizontalAlignment="Left"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource SizeMeta}"
                               Foreground="{StaticResource TextMeta}" />
                    <TextBlock HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource SizeMeta}"
                               Foreground="{StaticResource TextMeta}"
                               Text="esc fechar" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</views:HubWindow>
