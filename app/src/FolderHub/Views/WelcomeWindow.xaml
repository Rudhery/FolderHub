<views:HubWindow x:Class="FolderHub.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hub="clr-namespace:FolderHub.Controls"
        xmlns:views="clr-namespace:FolderHub.Views"
        Title="Bem-vindo — FolderHub"
        Width="380"
        SizeToContent="Height"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="StepEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="{StaticResource SizeKey}" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource SizeInitial}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
            <Setter Property="Foreground" Value="{StaticResource TextMeta}" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  o botão de avançar, no tamanho desta janela  -->
        <Style x:Key="StepNext" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="{StaticResource SizeRowHint}" />
        </Style>
    </Window.Resources>

    <!--
        Sem acrílico: esta janela pede canto de 18px e o DWM arredonda em 8,
        deixando uma cunha fora do arco. Mesma decisão da configuração — ver o
        HubWindow.
    -->
    <Border x:Name="Shell"
            Background="{StaticResource ModalSurface}"
            BorderBrush="{StaticResource ModalBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="60"
                              Opacity="0.85"
                              ShadowDepth="18"
                              Color="Black"
                              Direction="270" />
        </Border.Effect>

        <Grid Margin="22,24,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ o passo de agora ============  -->

            <Grid Grid.Row="0" MinHeight="212">

                <!--  1 · escolher a pasta  -->
                <StackPanel x:Name="StepFolder" hub:HubSpacing.Gap="Medium">
                    <Border Width="44"
                            Height="44"
                            Padding="9,10"
                            HorizontalAlignment="Left"
                            BorderBrush="{StaticResource BrandBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusRow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                                <GradientStop Offset="0" Color="{Binding Source={StaticResource BrandTileStart}, Path=Color}" />
                                <GradientStop Offset="1" Color="{Binding Source={StaticResource BrandTileEnd}, Path=Color}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center" hub:HubSpacing.Gap="None">
                            <Border Height="5"
                                    Margin="0,0,0,4"
                                    Background="{StaticResource BrandBarStrong}"
                                    CornerRadius="{StaticResource RadiusThumb}" />
                            <Border Height="5"
                                    Margin="0,0,7,4"
                                    Background="{StaticResource BrandBar}"
                                    CornerRadius="{StaticResource RadiusThumb}" />
                            <Border Height="5"
                                    Margin="0,0,14,0"
                                    Background="{StaticResource BrandBarQuiet}"
                                    CornerRadius="{StaticResource RadiusThumb}" />
                        </StackPanel>
                    </Border>

                    <StackPanel hub:HubSpacing.Gap="XSmall">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Bem-vindo ao Folder Hub" />
                        <TextBlock Style="{StaticResource StepText}"
                                   Text="Escolha uma pasta com atalhos. Ela vira seu primeiro hub — dá para adicionar outros depois." />
                    </StackPanel>

                    <!--
                        O alvo é o mesmo tracejado de "adicionar hub" da
                        configuração, mais alto: aqui ele é a única ação da tela.
                    -->
                    <Button x:Name="PickFolder"
                            Height="64"
                            Click="PickFolder_Click"
                            Content="Selecionar pasta"
                            Style="{StaticResource DashedButton}" />

                    <TextBlock x:Name="FolderSummary"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource SizeMeta}"
                               Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                </StackPanel>

                <!--  2 · atalho global  -->
                <StackPanel x:Name="StepHotKey" hub:HubSpacing.Gap="Medium" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource StepEyebrow}" Text="PASSO 2" />

                    <StackPanel hub:HubSpacing.Gap="XSmall">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Defina o atalho" />
                        <TextBlock Style="{StaticResource StepText}"
                                   Text="Pressione a combinação que vai abrir o hub de qualquer lugar do Windows." />
                    </StackPanel>

                    <hub:HubHotKeyBox x:Name="HotKeyBox"
                                      HotKeyChanged="HotKeyBox_HotKeyChanged"
                                      Style="{StaticResource WelcomeHotKeyBox}" />

                    <Grid Margin="0,4,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="{StaticResource SizeTab}"
                                   Foreground="{StaticResource TextLabel}"
                                   Text="Iniciar com o Windows" />
                        <hub:HubToggle x:Name="StartWithWindows"
                                       HorizontalAlignment="Right"
                                       IsChecked="True" />
                    </Grid>
                </StackPanel>

                <!--  3 · pronto  -->
                <StackPanel x:Name="StepDone" hub:HubSpacing.Gap="Medium" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource StepEyebrow}" Text="TUDO PRONTO" />

                    <StackPanel hub:HubSpacing.Gap="XSmall">
                        <TextBlock Style="{StaticResource StepTitle}" Text="Seu hub está montado" />
                        <TextBlock x:Name="DoneSummary" Style="{StaticResource StepText}" />
                    </StackPanel>

                    <!--
                        As miniaturas são os atalhos que a pasta tem de verdade —
                        é a primeira prova de que a pasta virou o hub.
                    -->
                    <ItemsControl x:Name="Preview" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="52"
                                        Margin="3.5,0"
                                        Background="{StaticResource SunkenBg}"
                                        BorderBrush="{StaticResource SunkenBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusTile}">
                                    <hub:HubIcon HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Size="22"
                                                 Source="{Binding Icon}"
                                                 Text="{Binding Initial}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="DoneHint" Style="{StaticResource StepText}" />
                </StackPanel>
            </Grid>

            <!--  ============ rodapé ============  -->

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="0,14,0,0"
                    BorderBrush="{StaticResource RowLine}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <hub:HubSteps x:Name="Steps"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Count="3"
                                  Current="1" />

                    <StackPanel x:Name="Actions"
                                HorizontalAlignment="Right"
                                hub:HubSpacing.Gap="Small"
                                Orientation="Horizontal">
                        <Button x:Name="Back"
                                Click="Back_Click"
                                Content="Voltar"
                                Style="{StaticResource QuietButton}"
                                Visibility="Collapsed" />
                        <Button x:Name="Next"
                                Click="Next_Click"
                                Content="Avançar"
                                IsEnabled="False"
                                Style="{StaticResource StepNext}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:HubWindow>
