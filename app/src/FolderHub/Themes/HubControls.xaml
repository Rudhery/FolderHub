<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hub="clr-namespace:FolderHub.Controls"
                    xmlns:svc="clr-namespace:FolderHub.Services">

    <!--
        ============================================================
        HubControls — como as coisas do FolderHub se desenham
        ============================================================

        Nenhum número de cor, raio ou tamanho aqui: tudo vem por StaticResource
        do HubTheme.xaml, e o tempo das animações vem por x:Static do
        Controls/HubMotion.cs. Se um literal aparecer neste arquivo, é um token
        faltando no tema.

        Os estilos sem x:Key são os padrões dos controles da casa — o WPF os
        acha pelo tipo, então uma tela nova escreve <hub:HubCard /> e pronto.
    -->

    <svc:BoolToVisibilityConverter x:Key="BoolToVis" />

    <!--
        ============ ÍCONE ============
        Três origens possíveis, uma escolhida por precedência no próprio
        controle. O modelo só mostra a que venceu.
    -->
    <Style TargetType="{x:Type hub:HubIcon}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="{StaticResource SizeGlyph}" />
        <Setter Property="Foreground" Value="{StaticResource Glyph}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubIcon}">
                    <Grid>
                        <Image x:Name="Picture"
                               Width="{TemplateBinding Size}"
                               Height="{TemplateBinding Size}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{TemplateBinding Source}"
                               Stretch="Uniform"
                               Visibility="Collapsed" />

                        <TextBlock x:Name="Symbol"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding GlyphText}"
                                   Visibility="Collapsed" />

                        <!--  a inicial do nome usa a fonte da interface, não a de ícones  -->
                        <TextBlock x:Name="Letters"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Text}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Mode" Value="Image">
                            <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Mode" Value="Glyph">
                            <Setter TargetName="Symbol" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Mode" Value="Text">
                            <Setter TargetName="Letters" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ TECLA DESENHADA ============
        A moldurinha de "Tab", "/", "Esc".
    -->
    <Style TargetType="{x:Type hub:HubKey}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="{StaticResource KeyBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource KeyBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource KeyText}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeKey}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubKey}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusKey}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Text}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ BOTÃO DE ÍCONE ============  -->
    <Style TargetType="{x:Type hub:HubIconButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="{StaticResource SizeGlyph}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubIconButton}">
                    <Border x:Name="Fill"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusButton}">
                        <hub:HubIcon x:Name="Symbol"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     Glyph="{TemplateBinding Glyph}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource ControlBgHover}" />
                            <Setter TargetName="Symbol" Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource CardBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ CARD ============

        Cada estado é uma camada com a cor exata do design, e o
        VisualStateManager cruza as opacidades. Sobrepor uma cor translúcida na
        outra somaria os alfas e daria um tom mais claro do que o especificado —
        por isso a camada de baixo apaga enquanto a de cima acende.

        O estado "Normal" é vazio de propósito: ao sair de um estado o VSM
        devolve as propriedades ao valor do modelo sozinho, com a mesma duração.
        Era essa volta que antes precisava de um terceiro storyboard escrito à
        mão, com sete animações que tinham de continuar coerentes com os outros
        dois.
    -->
    <Style TargetType="{x:Type hub:HubCard}">
        <Setter Property="Padding" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubCard}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static hub:HubMotion.State}" />
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Base" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Storyboard.TargetName="Hovered" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Storyboard.TargetName="TileBase" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Storyboard.TargetName="TileHovered" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Base" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Storyboard.TargetName="Chosen" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Storyboard.TargetName="TileBase" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Storyboard.TargetName="TileChosen" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!--  box-shadow: 0 0 0 3px rgba(255,255,255,0.035)  -->
                        <Border x:Name="Ring"
                                Margin="-3"
                                BorderBrush="{StaticResource CardRing}"
                                BorderThickness="3"
                                CornerRadius="{StaticResource RadiusCardRing}"
                                Opacity="0" />

                        <Border x:Name="Base"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCard}" />
                        <Border x:Name="Hovered"
                                Background="{StaticResource CardBgHover}"
                                BorderBrush="{StaticResource CardBorderHover}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCard}"
                                Opacity="0" />
                        <Border x:Name="Chosen"
                                Background="{StaticResource CardBgSelected}"
                                BorderBrush="{StaticResource CardBorderSelected}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusCard}"
                                Opacity="0" />

                        <!--  forma de bloco: ícone em cima, rótulo embaixo  -->
                        <StackPanel x:Name="Tile"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                            <Grid Width="{StaticResource TileSize}"
                                  Height="{StaticResource TileSize}"
                                  HorizontalAlignment="Center">
                                <Border x:Name="TileBase"
                                        Background="{StaticResource TileBg}"
                                        BorderBrush="{StaticResource TileBorder}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusTile}" />
                                <Border x:Name="TileHovered"
                                        Background="{StaticResource TileBgHover}"
                                        BorderBrush="{StaticResource TileBorderHover}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusTile}"
                                        Opacity="0" />
                                <Border x:Name="TileChosen"
                                        Background="{StaticResource TileBgSelected}"
                                        BorderBrush="{StaticResource TileBorderSelected}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusTile}"
                                        Opacity="0" />

                                <hub:HubIcon x:Name="Symbol"
                                             FontSize="{StaticResource SizeInitial}"
                                             Glyph="{TemplateBinding Glyph}"
                                             Size="26"
                                             Source="{TemplateBinding Icon}"
                                             Text="{TemplateBinding IconText}" />
                            </Grid>

                            <TextBlock x:Name="Caption"
                                       Height="30"
                                       Margin="0,12,0,0"
                                       FontSize="{StaticResource SizeCard}"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextLabel}"
                                       LineHeight="15"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="{TemplateBinding Label}"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  forma livre: qualquer conteúdo  -->
                        <ContentPresenter x:Name="Body"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Layout" Value="Tile">
                            <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  um degrau acima: para o que a tela quer que se olhe primeiro  -->
                        <Trigger Property="Variant" Value="Raised">
                            <Setter TargetName="Base" Property="Background" Value="{StaticResource CardBgSelected}" />
                            <Setter TargetName="Base" Property="BorderBrush" Value="{StaticResource CardBorderSelected}" />
                        </Trigger>

                        <!--  linha de lista: uma borda por item viraria grade  -->
                        <Trigger Property="Variant" Value="Quiet">
                            <Setter TargetName="Base" Property="Background" Value="Transparent" />
                            <Setter TargetName="Base" Property="BorderBrush" Value="Transparent" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="Symbol" Property="Foreground" Value="{StaticResource GlyphHover}" />
                        </MultiTrigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource TextStrong}" />
                            <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Symbol" Property="Foreground" Value="{StaticResource GlyphSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ ABA ============
        A mesma mecânica do card, em pílula: bloquinho de 14px com um ponto de
        5px, nome e contagem.
    -->
    <Style TargetType="{x:Type hub:HubTabItem}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubTabItem}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{x:Static hub:HubMotion.State}" />
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Base" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Storyboard.TargetName="Hovered" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Base" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Storyboard.TargetName="Chosen" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Base"
                                Background="{StaticResource TabBg}"
                                BorderBrush="{StaticResource TabBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusTab}" />
                        <Border x:Name="Hovered"
                                Background="{StaticResource TabBgHover}"
                                BorderBrush="{StaticResource TabBorderHover}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusTab}"
                                Opacity="0" />
                        <Border x:Name="Chosen"
                                Background="{StaticResource TabBgSelected}"
                                BorderBrush="{StaticResource TabBorderSelected}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusTab}"
                                Opacity="0" />

                        <!--
                            O respiro vai numa borda invisível de 1px, e não
                            como margem do conteúdo: Border.Padding fica DENTRO
                            da espessura da borda, então medir a partir da borda
                            externa encolhia a pílula em 1px de cada lado.
                        -->
                        <Border Padding="{TemplateBinding Padding}"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <StackPanel VerticalAlignment="Center"
                                        hub:HubSpacing.Gap="Small"
                                        Orientation="Horizontal">
                                <!--  moldura constante; a marca dentro é que diz o estado  -->
                                <Border Width="14"
                                        Height="14"
                                        Background="{StaticResource TabTileBg}"
                                        CornerRadius="{StaticResource RadiusTabTile}">
                                    <Border x:Name="Dot"
                                            Width="5"
                                            Height="5"
                                            Background="{StaticResource TabDot}"
                                            CornerRadius="1" />
                                </Border>

                                <TextBlock x:Name="Caption"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource SizeTab}"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource TabLabel}"
                                           Text="{TemplateBinding Label}" />

                                <TextBlock x:Name="Tally"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource SizeKey}"
                                           Foreground="{StaticResource TabCount}"
                                           Text="{TemplateBinding Tally}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource TabDotHover}" />
                        </MultiTrigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource TextStrong}" />
                            <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Dot" Property="Background" Value="{StaticResource TabDotSelected}" />
                            <Setter TargetName="Tally" Property="Foreground" Value="{StaticResource TabCountSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ BARRA DE ROLAGEM ============
        A padrão do WPF rouba 10px de largura do conteúdo, o que colapsava uma
        coluna inteira da grade. Esta flutua por cima.
    -->
    <Style x:Key="ThinScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Fill"
                            Margin="3,0"
                            Background="{StaticResource ScrollThumb}"
                            CornerRadius="{StaticResource RadiusThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource ScrollThumbDragging}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
        <Grid>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
            <!--
                Margem negativa de propósito: a barra sai da grade e vai flutuar
                no respiro da janela. Sobreposta, ela encostava na última coluna
                de cards; reservar espaço para ela custaria uma coluna inteira.
            -->
            <ScrollBar x:Name="PART_VerticalScrollBar"
                       Margin="0,0,-16,0"
                       HorizontalAlignment="Right"
                       Style="{StaticResource ThinScrollBar}"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       Orientation="Vertical"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>

    <!--  a lista sem cromo: só a grade e a barra flutuante  -->
    <Style x:Key="BareListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}"
                                  CanContentScroll="False"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Template="{StaticResource OverlayScrollViewer}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ CHAVINHA ============
        O botão desliza; o trilho troca de cor. As duas coisas na mesma duração,
        senão a cor chega antes e o movimento parece atrasado.
    -->
    <Style TargetType="{x:Type hub:HubToggle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubToggle}">
                    <Grid>
                        <Border x:Name="Track"
                                Background="{StaticResource ToggleTrack}"
                                BorderBrush="{StaticResource ToggleTrackBorder}"
                                BorderThickness="1"
                                CornerRadius="11" />
                        <Border x:Name="TrackOn"
                                Background="{StaticResource ToggleTrackOn}"
                                BorderBrush="{StaticResource ToggleTrackOnBorder}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Opacity="0" />
                        <Border x:Name="Knob"
                                Width="14"
                                Height="14"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Left"
                                Background="{StaticResource ToggleKnob}"
                                CornerRadius="7">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="Slide" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource ControlBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource ToggleKnobOn}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide"
                                                         Storyboard.TargetProperty="X"
                                                         To="16"
                                                         Duration="{x:Static hub:HubMotion.State}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="{x:Static hub:HubMotion.State}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{x:Static hub:HubMotion.State}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{x:Static hub:HubMotion.State}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ LINHA DE CONFIGURAÇÃO ============  -->
    <Style TargetType="{x:Type hub:HubOption}">
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubOption}">
                    <Grid Margin="{TemplateBinding Padding}" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="{StaticResource SizeBody}"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextLabel}"
                                       Text="{TemplateBinding Title}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="Explain"
                                       Margin="0,3,0,0"
                                       FontSize="{StaticResource SizeHint}"
                                       Foreground="{StaticResource TextFaint}"
                                       Text="{TemplateBinding Description}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  sem explicação a linha não deve deixar um vão embaixo do título  -->
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Explain" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Explain" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ NÚMERO COM MENOS E MAIS ============  -->
    <Style TargetType="{x:Type hub:HubStepper}">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubStepper}">
                    <Border Padding="3,0"
                            Background="{StaticResource ControlBg}"
                            BorderBrush="{StaticResource ControlBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <hub:HubIconButton x:Name="PART_Decrease"
                                               Width="22"
                                               Height="22"
                                               Glyph="Remove"
                                               IsEnabled="{TemplateBinding CanDecrease}" />

                            <TextBlock MinWidth="18"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource SizeBody}"
                                       Foreground="{StaticResource TextPrimary}"
                                       Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextAlignment="Center" />

                            <TextBlock x:Name="UnitText"
                                       Margin="5,0,3,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource SizeHint}"
                                       Foreground="{StaticResource TextFaint}"
                                       Text="{TemplateBinding Unit}" />

                            <hub:HubIconButton x:Name="PART_Increase"
                                               Width="22"
                                               Height="22"
                                               Glyph="Add"
                                               IsEnabled="{TemplateBinding CanIncrease}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="UnitText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ CAMPO DE ATALHO ============  -->
    <Style TargetType="{x:Type hub:HubHotKeyBox}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type hub:HubHotKeyBox}">
                    <Border x:Name="Frame"
                            Padding="12,0"
                            Background="{StaticResource ControlBg}"
                            BorderBrush="{StaticResource ControlBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                        <TextBlock x:Name="Value"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource SizeKey}"
                                   Foreground="{StaticResource TextPrimary}"
                                   Text="{TemplateBinding Display}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource ControlBgHover}" />
                        </Trigger>
                        <Trigger Property="Capturing" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource CardBgSelected}" />
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CardBorderSelected}" />
                            <Setter TargetName="Value" Property="FontFamily" Value="{StaticResource UiFont}" />
                            <Setter TargetName="Value" Property="FontSize" Value="{StaticResource SizeHint}" />
                            <Setter TargetName="Value" Property="Foreground" Value="{StaticResource TextMeta}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ CAMPO DE TEXTO ============  -->
    <Style x:Key="HubTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionFill}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame"
                            Padding="{TemplateBinding Padding}"
                            Background="{StaticResource ControlBg}"
                            BorderBrush="{StaticResource ControlBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource ControlBgHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource CardBorderSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ SELETOR ============
        ComboBox com o cromo do Windows trocado. A lista é a mesma máquina do
        menu de contexto, então usa a mesma superfície e o mesmo item.
    -->
    <Style x:Key="HubSelectItem" TargetType="ComboBoxItem">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextLabel}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fill"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusMenuItem}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource CardBgHover}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubSelect" TargetType="ComboBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource HubSelectItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle"
                                      Cursor="Hand"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Frame"
                                            Padding="12,0"
                                            Background="{StaticResource ControlBg}"
                                            BorderBrush="{StaticResource ControlBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusControl}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                            <hub:HubIcon Grid.Column="1"
                                                         Margin="8,0,0,0"
                                                         FontSize="{StaticResource SizeGlyphSmall}"
                                                         Foreground="{StaticResource TextMuted}"
                                                         Glyph="ChevronDown" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource ControlBgHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               VerticalOffset="4">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Margin="0,0,10,10"
                                    Padding="5"
                                    Background="{StaticResource MenuSurface}"
                                    BorderBrush="{StaticResource SurfaceBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMenu}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="4" Color="Black" />
                                </Border.Effect>
                                <ItemsPresenter />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ BOTÃO DISCRETO ============  -->
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fill"
                            Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusQuiet}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource CardBgHover}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{StaticResource CardBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource CardBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ============ BUSCA ============  -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionFill}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ MENUS ============
        Ficam aqui, e não dentro de uma janela, para que qualquer tela alcance.
    -->
    <Style x:Key="HubMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextLabel}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Fill"
                            Padding="10,0"
                            Background="Transparent"
                            CornerRadius="{StaticResource RadiusMenuItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <hub:HubIcon Grid.Column="0"
                                         HorizontalAlignment="Left"
                                         FontSize="{StaticResource SizeGlyphSmall}"
                                         Foreground="{StaticResource TextPrimary}"
                                         Glyph="Check"
                                         Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Header" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource CardBgHover}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource Divider}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HubContextMenu" TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Padding="5"
                            Background="{StaticResource MenuSurface}"
                            BorderBrush="{StaticResource SurfaceBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMenu}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" Opacity="0.7" ShadowDepth="6" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
