<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Paleta vinda do design "Folder Hub v2". Monocromática fria: nenhuma cor
        de destaque — o peso visual vem só de opacidade de branco.
        Comentários mostram o valor original em rgba().
    -->

    <!-- superfície do modal: rgba(26,28,32,0.86) -->
    <SolidColorBrush x:Key="Surface" Color="#DB1A1C20" />
    <!-- rgba(255,255,255,0.07) -->
    <SolidColorBrush x:Key="SurfaceBorder" Color="#12FFFFFF" />
    <!-- rgba(255,255,255,0.055) -->
    <SolidColorBrush x:Key="Divider" Color="#0EFFFFFF" />

    <SolidColorBrush x:Key="TextPrimary" Color="#EEF1F4" />
    <SolidColorBrush x:Key="TextStrong" Color="#FFFFFF" />
    <!-- rgba(238,241,244,0.88) -->
    <SolidColorBrush x:Key="TextLabel" Color="#E0EEF1F4" />
    <!-- rgba(238,241,244,0.58) -->
    <SolidColorBrush x:Key="TextMeta" Color="#94EEF1F4" />
    <!-- rgba(238,241,244,0.45) -->
    <SolidColorBrush x:Key="TextMuted" Color="#73EEF1F4" />
    <!-- rgba(238,241,244,0.42) -->
    <SolidColorBrush x:Key="TextFaint" Color="#6BEEF1F4" />
    <!-- glifo neutro do design -->
    <SolidColorBrush x:Key="Glyph" Color="#8FA6BD" />
    <SolidColorBrush x:Key="GlyphHover" Color="#B3C5D6" />
    <SolidColorBrush x:Key="GlyphSelected" Color="#DBE4EC" />

    <!-- véu do arrastar e soltar: a superfície, quase opaca -->
    <SolidColorBrush x:Key="Scrim" Color="#E61A1C20" />

    <!-- card: rgba(255,255,255,0.028) / borda rgba(255,255,255,0.05) -->
    <SolidColorBrush x:Key="CardBg" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#0EFFFFFF" />
    <!-- hover: rgba(255,255,255,0.065) / rgba(255,255,255,0.12) -->
    <SolidColorBrush x:Key="CardBgHover" Color="#11FFFFFF" />
    <SolidColorBrush x:Key="CardBorderHover" Color="#1FFFFFFF" />
    <!-- selecionado: rgba(255,255,255,0.075) / rgba(255,255,255,0.22) -->
    <SolidColorBrush x:Key="CardBgSelected" Color="#13FFFFFF" />
    <SolidColorBrush x:Key="CardBorderSelected" Color="#33FFFFFF" />
    <!-- anel externo do selecionado: rgba(255,255,255,0.05) -->
    <!-- anel do card selecionado: 3px, rgba(255,255,255,0.035) -->
    <SolidColorBrush x:Key="CardRing" Color="#09FFFFFF" />

    <!-- aba: pílula transparente que só ganha fundo no hover -->
    <SolidColorBrush x:Key="TabBg" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="TabBorder" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="TabBgHover" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="TabBorderHover" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TabBgSelected" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="TabBorderSelected" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="TabLabel" Color="#BFEEF1F4" />
    <SolidColorBrush x:Key="TabCount" Color="#8CEEF1F4" />
    <SolidColorBrush x:Key="TabCountSelected" Color="#99EEF1F4" />

    <!-- tecla desenhada (Tab, /) -->
    <SolidColorBrush x:Key="KeyBg" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="KeyBorder" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="KeyText" Color="#8CEEF1F4" />
    <SolidColorBrush x:Key="Hint" Color="#94EEF1F4" />

    <!-- bloco do ícone dentro do card -->
    <SolidColorBrush x:Key="TileBg" Color="#22252A" />
    <SolidColorBrush x:Key="TileBorder" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="TileBgHover" Color="#282C32" />
    <SolidColorBrush x:Key="TileBorderHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TileBgSelected" Color="#2C3138" />
    <SolidColorBrush x:Key="TileBorderSelected" Color="#1AFFFFFF" />

    <!-- controles sutis (busca, botões) -->
    <SolidColorBrush x:Key="ControlBg" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ControlBgHover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderHover" Color="#1FFFFFFF" />

    <!-- Manrope + JetBrains Mono, embutidas em Assets/Fonts -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Manrope</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>

    <sys:Double x:Key="CardWidth">160</sys:Double>
    <sys:Double x:Key="CardHeight">118</sys:Double>
    <sys:Double x:Key="TileSize">40</sys:Double>

    <Duration x:Key="StateDuration">0:0:0.15</Duration>

    <!--
        ============ FORMA ============
        Nomeados pelo papel, não pelo valor: dois elementos com o mesmo raio hoje
        podem divergir amanhã sem virar caça ao número no XAML.
    -->
    <CornerRadius x:Key="RadiusWindow">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusCardRing">17</CornerRadius>
    <CornerRadius x:Key="RadiusTile">12</CornerRadius>
    <!-- 999 = pílula: o raio maior que a metade da altura arredonda por inteiro -->
    <CornerRadius x:Key="RadiusTab">999</CornerRadius>
    <CornerRadius x:Key="RadiusTabTile">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">11</CornerRadius>
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusKey">6</CornerRadius>
    <CornerRadius x:Key="RadiusQuiet">10</CornerRadius>
    <CornerRadius x:Key="RadiusMenu">12</CornerRadius>
    <CornerRadius x:Key="RadiusMenuItem">7</CornerRadius>
    <CornerRadius x:Key="RadiusThumb">3</CornerRadius>

    <!-- ============ ESCALA TIPOGRÁFICA ============ -->
    <sys:Double x:Key="SizeTitle">14</sys:Double>
    <sys:Double x:Key="SizeInitial">15</sys:Double>
    <sys:Double x:Key="SizeBody">12.5</sys:Double>
    <sys:Double x:Key="SizeCard">11.5</sys:Double>
    <sys:Double x:Key="SizeTab">12</sys:Double>
    <sys:Double x:Key="SizeHint">11</sys:Double>
    <sys:Double x:Key="SizeMeta">10.5</sys:Double>
    <sys:Double x:Key="SizeKey">10</sys:Double>
    <sys:Double x:Key="SizeGlyph">11</sys:Double>
    <sys:Double x:Key="SizeGlyphLarge">17</sys:Double>
    <sys:Double x:Key="SizeGlyphSmall">10</sys:Double>

    <!-- ============ SCROLLBAR ============ -->
    <Style x:Key="ThinScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="B" Margin="3,0" Background="#1FFFFFFF" CornerRadius="{StaticResource RadiusThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#3DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="B" Property="Background" Value="#5CFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ThinScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ BOTÃO DO CABEÇALHO ============
        24x24, raio 6, fundo transparente que vira rgba(255,255,255,0.07) no hover.
    -->
    <!--
        ============ TECLA DESENHADA ============
        A moldurinha que representa uma tecla ("Tab", "/"). Style em vez de
        UserControl porque o conteúdo muda mas a caixa nunca: assim cada uso
        são duas linhas de XAML e nenhuma classe nova.
    -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KeyBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource KeyBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusKey}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeKey}" />
        <Setter Property="Foreground" Value="{StaticResource KeyText}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="GlyphButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="{StaticResource SizeGlyph}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B" Background="Transparent" CornerRadius="{StaticResource RadiusButton}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource ControlBgHover}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource CardBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ BOTÃO DISCRETO ============ -->
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="B"
                            Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusQuiet}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource CardBgHover}" />
                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource CardBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource CardBg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============ MENUS ============
        Ficavam dentro do MainWindow, onde nenhuma outra janela alcançava.
    -->
    <!--  ============ MENU DE CONTEXTO ============  -->
    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextLabel}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="MenuItem">
                <Border x:Name="B" Padding="10,0" Background="Transparent" CornerRadius="{StaticResource RadiusMenuItem}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="19" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="{StaticResource SizeGlyphSmall}"
                               Foreground="{StaticResource TextPrimary}"
                               Text="&#xE73E;"
                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Header" />
                </Grid>
                </Border>
                <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="B" Property="Background" Value="{StaticResource CardBgHover}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="9,5" />
        <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Separator">
                <Border Height="1" Background="{StaticResource Divider}" />
            </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ContextMenu">
                <Border Padding="5"
                        Background="#F51A1C20"
                        BorderBrush="{StaticResource SurfaceBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMenu}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" Opacity="0.7" ShadowDepth="6" Color="Black" />
                </Border.Effect>
                <StackPanel IsItemsHost="True" />
                </Border>
            </ControlTemplate>
        </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ BUSCA ============ -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="#8FA6BD" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
