<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FolderHub</AssemblyName>
    <RootNamespace>FolderHub</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\folderhub.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>FolderHub</Product>
    <Company>FolderHub</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Manrope e JetBrains Mono (SIL Open Font License) embutidas no exe -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Page Update="Themes\Light.xaml" />
  </ItemGroup>

</Project>
