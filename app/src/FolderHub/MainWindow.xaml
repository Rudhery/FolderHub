<views:HubWindow x:Class="FolderHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hub="clr-namespace:FolderHub.Controls"
        xmlns:views="clr-namespace:FolderHub.Views"
        Title="FolderHub"
        Width="562"
        SizeToContent="Height"
        AllowDrop="True">

    <!--
        Chrome, acrílico, Esc e o fade vêm de HubWindow.
        Cor, forma e movimento vêm de Themes/HubTheme.xaml e HubControls.xaml —
        esta janela só diz o que quer, não como se desenha.
    -->

    <Window.Resources>
        <!--
            O card do hub: o HubCard padrão, com a medida da grade e o que ele
            mostra de cada atalho. A entrada escalonada precisa do Loaded.
        -->
        <Style x:Key="AppCard" TargetType="{x:Type hub:HubCard}" BasedOn="{StaticResource {x:Type hub:HubCard}}">
            <Setter Property="Width" Value="{DynamicResource CardWidth}" />
            <Setter Property="Height" Value="{DynamicResource CardHeight}" />
            <!--  5 de cada lado = os 10px de vão do design  -->
            <Setter Property="Margin" Value="5" />
            <!--  medida do desenho, não da escala  -->
            <Setter Property="Padding" Value="8,20,8,15" />
            <Setter Property="Icon" Value="{Binding Icon}" />
            <Setter Property="IconText" Value="{Binding Initial}" />
            <Setter Property="Label" Value="{Binding Name}" />
            <EventSetter Event="Loaded" Handler="Card_Loaded" />
        </Style>

        <Style x:Key="TabPill" TargetType="{x:Type hub:HubTabItem}" BasedOn="{StaticResource {x:Type hub:HubTabItem}}">
            <Setter Property="Label" Value="{Binding Name}" />
            <Setter Property="Tally" Value="{Binding Count}" />
            <EventSetter Event="MouseRightButtonUp" Handler="TabItem_MouseRightButtonUp" />
        </Style>

        <ContextMenu x:Key="TabMenu" Style="{StaticResource HubContextMenu}">
            <MenuItem Style="{StaticResource HubMenuItem}" Click="RevealTab_Click" Header="Abrir esta pasta" />
            <MenuItem Style="{StaticResource HubMenuItem}"
                      Click="RemoveTab_Click"
                      Header="Remover esta aba"
                      Tag="remove" />
        </ContextMenu>

        <!--  bandeja: clique direito no ícone  -->
        <ContextMenu x:Key="TrayMenu" Style="{StaticResource HubContextMenu}">
            <MenuItem Style="{StaticResource HubMenuItem}" Click="TrayOpen_Click" Header="Abrir o hub" />
            <!--  residente e escondido, a bandeja é o único caminho para a configuração  -->
            <MenuItem Style="{StaticResource HubMenuItem}" Click="Settings_Click" Header="Configuração…" />
            <MenuItem Style="{StaticResource HubMenuItem}"
                      Click="ToggleStartup_Click"
                      Header="Iniciar com o Windows"
                      Tag="startup" />
            <Separator Style="{StaticResource HubSeparator}" />
            <MenuItem Style="{StaticResource HubMenuItem}" Click="TrayExit_Click" Header="Sair" />
        </ContextMenu>

        <!--  clique direito no cabeçalho  -->
        <ContextMenu x:Key="OptionsMenu" Style="{StaticResource HubContextMenu}">
            <MenuItem Style="{StaticResource HubMenuItem}" Click="Settings_Click" Header="Configuração…" />
            <Separator Style="{StaticResource HubSeparator}" />
            <MenuItem Style="{StaticResource HubMenuItem}"
                      Click="ToggleResident_Click"
                      Header="Modo residente"
                      Tag="resident" />
            <MenuItem Style="{StaticResource HubMenuItem}"
                      Click="ToggleStartup_Click"
                      Header="Iniciar com o Windows"
                      Tag="startup" />
            <Separator Style="{StaticResource HubSeparator}" />
            <MenuItem Style="{StaticResource HubMenuItem}" Click="AddTab_Click" Header="Adicionar uma aba…" />
            <MenuItem Style="{StaticResource HubMenuItem}" Click="OpenFolder_Click" Header="Abrir a pasta do hub" />
            <MenuItem Style="{StaticResource HubMenuItem}" Click="OpenConfig_Click" Header="Abrir a pasta da configuração" />
        </ContextMenu>
    </Window.Resources>

    <!--  ================= JANELA =================  -->
    <Border x:Name="Shell"
            Padding="24,22,24,18"
            Background="{DynamicResource Surface}"
            BorderBrush="{StaticResource SurfaceBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}"
            Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShellLift" Y="8" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  busca  -->
                <RowDefinition Height="Auto" />
                <!--  abas  -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  ============ CABEÇALHO ============  -->
            <Grid x:Name="Header"
                  Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  MouseRightButtonUp="Header_MouseRightButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!--  com a busca fora do cabeçalho, o título tem o dobro do espaço  -->
                    <TextBlock x:Name="TitleText"
                               MaxWidth="300"
                               HorizontalAlignment="Left"
                               FontSize="{StaticResource SizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Folder Hub"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText"
                               MaxWidth="320"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Left"
                               FontSize="{StaticResource SizeBody}"
                               Foreground="{StaticResource TextFaint}"
                               Text="Escolha um aplicativo"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            hub:HubSpacing.Gap="XSmall"
                            Orientation="Horizontal">
                    <hub:HubIconButton Click="Sort_Click" Glyph="Sort" ToolTip="Ordenar">
                        <hub:HubIconButton.ContextMenu>
                            <ContextMenu Style="{StaticResource HubContextMenu}">
                                <MenuItem Style="{StaticResource HubMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Manual &#x2014; arraste os cards"
                                          Tag="Manual" />
                                <MenuItem Style="{StaticResource HubMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Nome (A &#x2192; Z)"
                                          Tag="NameAsc" />
                                <MenuItem Style="{StaticResource HubMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Nome (Z &#x2192; A)"
                                          Tag="NameDesc" />
                                <MenuItem Style="{StaticResource HubMenuItem}"
                                          Click="SortMode_Click"
                                          Header="Mais recentes"
                                          Tag="Recent" />
                                <Separator Style="{StaticResource HubSeparator}" />
                                <MenuItem Style="{StaticResource HubMenuItem}"
                                          Click="FreezeOrder_Click"
                                          Header="Gravar esta ordem na pasta" />
                            </ContextMenu>
                        </hub:HubIconButton.ContextMenu>
                    </hub:HubIconButton>

                    <hub:HubIconButton Click="ChangeFolder_Click" Glyph="Folder" ToolTip="Trocar pasta (Ctrl+O)" />
                    <hub:HubIconButton Click="Reload_Click" Glyph="Reload" ToolTip="Recarregar (F5)" />
                    <hub:HubIconButton Click="Settings_Click" Glyph="Settings" ToolTip="Configurações" />
                    <hub:HubIconButton Click="Close_Click" Glyph="Close" ToolTip="Fechar (Esc)" />
                </StackPanel>
            </Grid>

            <!--
                ============ BUSCA ============
                Saiu do cabeçalho e ganhou a largura toda. A tecla desenhada à
                direita não é enfeite: "/" devolve o foco para cá.
            -->
            <Border x:Name="SearchRow"
                    Grid.Row="1"
                    Height="34"
                    Margin="0,16,0,0"
                    Background="{StaticResource ControlBg}"
                    BorderBrush="{StaticResource ControlBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <hub:HubIcon Grid.Column="0"
                                 Margin="0,0,9,0"
                                 Foreground="{StaticResource TextMuted}"
                                 Glyph="Search" />

                    <Grid Grid.Column="1">
                        <TextBlock x:Name="SearchPlaceholder"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource SizeBody}"
                                   Foreground="{StaticResource TextFaint}"
                                   IsHitTestVisible="False"
                                   Text="Buscar" />
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource SearchBox}"
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <hub:HubKey Grid.Column="2" Margin="8,0,0,0" Text="/" />
                </Grid>
            </Border>

            <!--
                ============ ABAS ============
                Some com uma pasta só, então o layout de sempre não muda.
            -->
            <Border x:Name="TabRow"
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="0,0,0,12"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,0,0,1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <hub:HubTabList x:Name="TabStrip"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    ItemContainerStyle="{StaticResource TabPill}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    SelectionChanged="TabStrip_SelectionChanged">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </hub:HubTabList>

                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <hub:HubKey Text="Tab" />
                        <TextBlock Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource SizeHint}"
                                   Foreground="{StaticResource Hint}"
                                   Text="troca de hub" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ============ GRADE DE CARDS ============  -->
            <hub:HubCardList x:Name="Cards"
                             Grid.Row="3"
                             Margin="-5,11,-5,-5"
                             AllowDrop="True"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Style="{StaticResource BareListBox}"
                             ItemContainerStyle="{StaticResource AppCard}"
                             SelectionMode="Single"
                             VirtualizingPanel.IsVirtualizing="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <FrameworkElement.ContextMenu>
                    <ContextMenu Style="{StaticResource HubContextMenu}">
                        <MenuItem Style="{StaticResource HubMenuItem}"
                                  Click="RunAsAdmin_Click"
                                  Header="Executar como administrador" />
                        <MenuItem Style="{StaticResource HubMenuItem}"
                                  Click="Reveal_Click"
                                  Header="Mostrar na pasta" />
                    </ContextMenu>
                </FrameworkElement.ContextMenu>
            </hub:HubCardList>

            <!--  ============ ESTADO VAZIO ============  -->
            <StackPanel x:Name="EmptyState"
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Background="{StaticResource TileBg}"
                        BorderBrush="{StaticResource TileBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusTile}">
                    <hub:HubIcon FontSize="{StaticResource SizeGlyphLarge}" Glyph="Folder" />
                </Border>
                <TextBlock x:Name="EmptyTitle"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource SizeTitle}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Text="Nenhum atalho aqui" />
                <TextBlock x:Name="EmptyHint"
                           MaxWidth="330"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontSize="{StaticResource SizeBody}"
                           Foreground="{StaticResource TextFaint}"
                           Text="Solte atalhos (.lnk, .url, .exe) dentro da pasta e eles aparecem aqui na hora."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource QuietButton}"
                        Click="OpenFolder_Click"
                        Content="Abrir a pasta" />
            </StackPanel>

            <!--  ============ RODAPÉ ============  -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Border Height="1" VerticalAlignment="Top" Background="{StaticResource Divider}" />
                <Grid Margin="0,14,0,0">
                    <TextBlock x:Name="CountText"
                               HorizontalAlignment="Left"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource SizeMeta}"
                               Foreground="{StaticResource TextMeta}"
                               Text="0 atalhos" />
                    <TextBlock HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource SizeMeta}"
                               Foreground="{StaticResource TextMeta}"
                               Text="&#x21B5; abrir &#xB7; esc fechar" />
                </Grid>
            </Grid>

            <!--  arrastar e soltar  -->
            <Border x:Name="DropOverlay"
                    Grid.Row="0"
                    Grid.RowSpan="5"
                    Margin="-24,-22,-24,-18"
                    Background="{StaticResource Scrim}"
                    CornerRadius="{StaticResource RadiusWindow}"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            Background="{StaticResource TileBgSelected}"
                            BorderBrush="{StaticResource TileBorderSelected}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusCard}" />
                    <TextBlock x:Name="DropText"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource SizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               Text="Solte para usar esta pasta" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:HubWindow>
