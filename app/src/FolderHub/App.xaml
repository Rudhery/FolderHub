<Application x:Class="FolderHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Os dois entram direto aqui, e não aninhados num terceiro
                dicionário: um tema externo é acrescentado a esta mesma lista
                depois, e o WPF procura os dicionários mesclados de trás para a
                frente. Quanto mais rasa a pilha, mais previsível é quem vence.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/HubTheme.xaml" />
                <ResourceDictionary Source="Themes/HubControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
